# ------------------------------------------------------------------------------------
# Game-Express — local / VPS / bot-host template. Copy to .env and fill in.
# On GitHub Actions use repository SECRETS (webhooks, tokens) and VARIABLES (the rest):
#   Settings → Secrets and variables → Actions.   (see README → Setup)
# ------------------------------------------------------------------------------------

# ── SECRETS ─────────────────────────────────────────────────────────────────────────
# Channel webhooks (Channel → Edit → Integrations → Webhooks → New → Copy URL).
# Routing: DISCORD_WEBHOOK_<FEATURE>_<GAME>  >  DISCORD_WEBHOOK_<FEATURE>  >  DISCORD_WEBHOOK_URL
DISCORD_WEBHOOK_SCHEDULE=https://discord.com/api/webhooks/...
# Codes: one channel per game (short names work too: _GI, _HSR, _WW, _NEXUSANIMA)
DISCORD_WEBHOOK_CODES_GENSHIN=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CODES_STARRAIL=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CODES_HNA=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CODES_ZZZ=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CODES_WUWA=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CODES_ANANTA=https://discord.com/api/webhooks/...
# DISCORD_WEBHOOK_CODES=                 # optional: codes of any game without its own secret
# DISCORD_WEBHOOK_URL=                   # optional catch-all fallback
# DISCORD_WEBHOOK_SCHEDULE_WUWA=         # optional per-game schedule channel
# DISCORD_WEBHOOK_TEST=                  # optional private test channel (Test workflow: live-test-channel)
# FORCE_WEBHOOK=                         # send EVERY card to this one webhook (testing only)
# Forum/thread channel: append ?thread_id=123 to the webhook URL.

# Optional: token for the token-gated nitter instance (same secret as News-Express)
NITTER_RSS_TOKEN=

# Bot mode only (python -m gamexpress bot):
DISCORD_BOT_TOKEN=

# ── VARIABLES (not secret) ─────────────────────────────────────────────────────────
# Ping role(s). Empty = NO ping. Comma-separate several roles. 'everyone' / 'here' allowed.
# Resolution: PING_<FEATURE>_<GAME>  >  PING_<FEATURE>  >  PING_ROLE_ID     ('none' = explicitly off)
PING_ROLE_ID=1296268365593186426
# PING_SCHEDULE=                          # e.g. a different role for schedule cards
# PING_CODES=none                         # e.g. no ping for code cards
# PING_SCHEDULE_GENSHIN=                  # per game
# NO_PING=1                               # never ping, whatever the lines above say

# Button emojis — "a:name:id" (animated) | "name:id" | unicode | none
EMOJI_YOUTUBE=a:kurobbseventcalendar:1508619925940473966
EMOJI_TWITCH=a:hsrbbsevanescia:1508647148902813776
# EMOJI_SOURCE=
# EMOJI_REDEEM=🎁
# Extra link buttons on every card (max 3), JSON:
# EXTRA_BUTTONS=[{"label":"Citlali News","url":"https://discord.gg/HyrVP9wRXu","emoji":"a:starward11:1439878792653832253"}]

# Features: schedule,codes | schedule | codes | none   (none = paused / cold standby)
ENABLED_FEATURES=schedule,codes
# GAMES=genshin,starrail                  # optional allow-list (default: every enabled game)
# ENABLE_GAMES=hna,ananta                 # switch prepared games on (ANANTA also auto-enables on 2027-01-15)

# Behaviour
# DRY_RUN=1                               # build + log cards, never post
# TEST_MODE=1                             # label cards 🧪 TEST, skip freshness/seed rules, never save state
# BOOTSTRAP_POST=1                        # first run also posts current items (default: silent seed)
# EDIT_ON_UPDATE=1                        # keep the posted card accurate with silent edits (default on)
# POST_ON_MAINTENANCE_NOTICE=1            # post a card from a maintenance notice if the program was missed
# LOOKBACK_HOURS=72
# CODES_MIN_SOURCES=2                     # independent community sources needed for an unverified code
# CODES_MARK_EXPIRED=1                    # strike through posted codes once every source lists them expired
# SHOW_LEGEND=1                           # "STC — Subject to Change • TBA — To be Announced" footer
# X_ENABLED=1
# NITTER_INSTANCES=https://nitter.cf,https://xitter.cf   # override the built-in fleet

# Scheduler: cron-job.org → workflow_dispatch every 10 min (docs/SCHEDULER.md). Not an env var.
# AUTO_MERGE_DEPENDABOT=yes               # repo VARIABLE (dev repo): auto-merge green Dependabot PRs

# Two-instance fail-over (see README → Redundancy)
# INSTANCE_NAME=alpha
# INSTANCE_ROLE=primary                   # primary | standby
# PEER_STATE_URL=https://raw.githubusercontent.com/<owner>/<other-repo>/main/state/state.json
# HEARTBEAT_MINUTES=60                    # primary: set 60 when a standby watches it (default 1440)
# FAILOVER_AFTER_MINUTES=150              # standby: activate when the primary is silent this long

# Hosting (loop / bot)
# LOOP_MINUTES=10
# PORT=8080                               # enables /healthz (Render / uptime pingers)
# LOG_LEVEL=INFO
