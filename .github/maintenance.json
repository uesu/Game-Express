{
  "schema_version": 2,
  "project": "Game-Express",
  "python": {
    "version_file": ".python-version",
    "ruff_config": "ruff.toml",
    "manifest_url": "https://raw.githubusercontent.com/actions/python-versions/main/versions-manifest.json",
    "release_dates_url": "https://endoflife.date/api/v1/products/python/",
    "release_dates_fallback_url": "https://endoflife.date/api/python.json",
    "supported_major": 3,
    "min_minor": 11,
    "max_validated_minor": 14,
    "allow_minor_upgrades": false,
    "max_minor_jump": 1,
    "minor_soak_days": 30,
    "runner_os": "linux",
    "runner_arch": "x64",
    "runner_platform_version": "24.04",
    "known_ruff_targets": [
      "py311",
      "py312",
      "py313",
      "py314"
    ],
    "workflow_files": [
      ".github/workflows/ci.yml",
      ".github/workflows/monitor.yml",
      ".github/workflows/python_version_bump.yml"
    ],
    "allowed_bump_files": [
      ".python-version",
      "ruff.toml",
      "requirements.txt",
      "requirements-dev.txt"
    ],
    "doc_files": [
      "README.md",
      "AGENTS.md",
      "docs/MAINTENANCE.md",
      "docs/PYTHON_VERSION.md",
      "docs/CONFIGURATION.md",
      "docs/DEPENDABOT.md",
      "docs/PROD-REPO-SETUP.md",
      "docs/ROLLOUT.md",
      "docs/SCHEDULER.md",
      "docs/SECURITY.md",
      "docs/TESTING.md",
      "docs/TROUBLESHOOTING.md",
      "docs/changelog/CHANGELOG.md"
    ]
  },
  "locks": {
    "compiler": {
      "pip": "26.2.1",
      "pip_tools": "7.5.3"
    },
    "targets": [
      {
        "name": "runtime",
        "input_file": "requirements.in",
        "output_file": "requirements.txt",
        "compile_command": "python -m piptools compile --generate-hashes --allow-unsafe --resolver=backtracking --strip-extras --output-file=requirements.txt requirements.in"
      },
      {
        "name": "dev",
        "input_file": "requirements-dev.in",
        "output_file": "requirements-dev.txt",
        "compile_command": "python -m piptools compile --generate-hashes --allow-unsafe --resolver=backtracking --strip-extras --output-file=requirements-dev.txt requirements-dev.in"
      }
    ]
  },
  "ci": {
    "workflow_name": "CI",
    "workflow_path": ".github/workflows/ci.yml",
    "final_gate_name": "maintenance-ci",
    "blocking_checks": [
      "verify",
      "lock-check",
      "ruff",
      "actionlint",
      "zizmor"
    ],
    "blocking_check_run_names": [
      "Verify (syntax, workflow contract & offline tests)",
      "Dependency lockfile consistency",
      "Ruff lint",
      "Workflow lint (actionlint)",
      "Workflow security audit (zizmor)",
      "maintenance-ci"
    ],
    "advisory_checks": [
      "pip-audit"
    ],
    "advisory_check_run_names": [
      "Dependency CVE audit (pip-audit, advisory)"
    ],
    "mandatory_check_groups": {
      "verify": [
        "Verify (syntax, workflow contract & offline tests)",
        "verify"
      ],
      "lock-check": [
        "Dependency lockfile consistency",
        "lock-check"
      ],
      "ruff": [
        "Ruff lint",
        "ruff"
      ],
      "actionlint": [
        "Workflow lint (actionlint)",
        "actionlint"
      ],
      "zizmor": [
        "Workflow security audit (zizmor)",
        "zizmor"
      ],
      "pip-audit": [
        "Dependency CVE audit (pip-audit, advisory)",
        "pip-audit"
      ],
      "maintenance-ci": [
        "maintenance-ci"
      ]
    },
    "registered_tests": [
      "tests/test_configuration_contract.py",
      "tests/test_gachawiki_placeholder.py",
      "tests/test_maintenance.py",
      "tests/test_run_summary.py",
      "tests/test_schedule_epithet_and_settled.py",
      "tests/test_smoke.py"
    ],
    "optional_dev_docs": [
      "README.md",
      "AGENTS.md",
      "docs"
    ]
  },
  "automerge": {
    "target_branch": "main",
    "merge_method": "SQUASH",
    "fallback_merge_methods": [
      "MERGE",
      "REBASE"
    ],
    "trusted_check_apps": [
      "github-actions"
    ],
    "trusted_ci_workflow_paths": [
      ".github/workflows/ci.yml"
    ],
    "trusted_ci_workflow_names": [
      "CI",
      "CI — compile + offline tests"
    ],
    "trusted_proposer_workflow_paths": [
      ".github/workflows/python_version_bump.yml"
    ],
    "trusted_proposer_workflow_names": [
      "Python Version Bump"
    ],
    "require_complete_check_set": true,
    "require_security_scan_evidence": true,
    "require_provenance": true,
    "required_checks": [
      "Verify (syntax, workflow contract & offline tests)",
      "Dependency lockfile consistency",
      "Ruff lint",
      "Workflow lint (actionlint)",
      "Workflow security audit (zizmor)",
      "Dependency CVE audit (pip-audit, advisory)",
      "maintenance-ci"
    ],
    "blocking_checks": [
      "verify",
      "lock-check",
      "ruff",
      "actionlint",
      "zizmor"
    ],
    "security_checks": [
      "pip-audit",
      "Dependency CVE audit (pip-audit, advisory)"
    ],
    "hold_labels": [
      "hold",
      "do-not-merge",
      "do not merge",
      "dont-merge",
      "blocked",
      "needs-review",
      "review-required",
      "human-review",
      "manual-review",
      "security-review",
      "wip"
    ],
    "waivers": [],
    "lanes": {
      "dependabot_pip": {
        "authors": [
          "dependabot[bot]",
          "app/dependabot"
        ],
        "opt_in_var": "AUTO_MERGE_DEPENDABOT",
        "opt_in_value": "yes",
        "branch_prefixes": [
          "dependabot/pip/"
        ],
        "allowed_files": [
          "requirements.in",
          "requirements.txt",
          "requirements-dev.in",
          "requirements-dev.txt"
        ],
        "allowed_update_types": [
          "patch",
          "minor"
        ]
      },
      "dependabot_actions": {
        "authors": [
          "dependabot[bot]",
          "app/dependabot"
        ],
        "opt_in_var": "AUTO_MERGE_DEPENDABOT",
        "opt_in_value": "yes",
        "branch_prefixes": [
          "dependabot/github_actions/",
          "dependabot/github-actions/"
        ],
        "allowed_files": [
          ".github/workflows/*.yml"
        ],
        "allowed_update_types": [
          "patch",
          "minor"
        ]
      },
      "python_bump": {
        "authors": [
          "github-actions[bot]",
          "app/github-actions",
          "uesu"
        ],
        "opt_in_var": "AUTO_MERGE_PYTHON_BUMP",
        "opt_in_value": "yes",
        "branch_names": [
          "chore/python-bump",
          "chore/python-version-bump"
        ],
        "allowed_files": [
          ".python-version",
          "ruff.toml",
          "requirements.txt",
          "requirements-dev.txt"
        ],
        "allowed_update_types": [
          "patch"
        ]
      }
    }
  }
}
